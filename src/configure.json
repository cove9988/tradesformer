{
    "data_processing": {
        "required_cols": ["time", "open", "high", "low", "close"],
        "min_bars_per_week": 1440,
        "train_eval_split": {
            "base_path": "./data/split/{symbol}/weekly",
            "train_dir": "train",
            "eval_dir": "eval"
        }
    },
    "env": {
        "observation_list": [
            "close_rel_week_open",
            "high_rel_week_open",
            "low_rel_week_open",
            "open_rel_week_open",
            "returns_12",
            "returns_48",
            "returns_96",
            "returns_288",
            "realized_vol_48",
            "realized_vol_96",
            "realized_vol_288",
            "atr_rel",
            "close_vs_sma_288",
            "close_vs_sma_576",
            "sma_288_vs_sma_576",
            "bar_range",
            "bar_body",
            "close_loc_in_bar",
            "hour_sin",
            "hour_cos",
            "minute_sin",
            "minute_cos",
            "london_session",
            "ny_session",
            "overlap_session",
            "week_progress"
        ],
        "target_series": "log_return_1",
        "forecast_objective": "cumulative_log_return",
        "direction_thresholds": {
            "12": {
                "positive": 0.001,
                "negative": -0.001
            },
            "24": {
                "positive": 0.0015,
                "negative": -0.0015
            }
        },
        "balance": 1000,
        "symbol_col": "symbol",
        "time_col": "time",
        "title": "{symbol} TimeFM weekly",
        "description": "TimeFM-first weekly FX dataset with causal relative-price, volatility, and session context features",
        "context_windows": [96, 192, 288],
        "forecast_horizons": [12, 24]
    },
    "symbol": {
        "GBPUSD": {
            "point": 100000,
            "max_spread": 50,
            "transaction_fee": -10,
            "over_night_penalty": -50,
            "stop_loss_max": -300,
            "profit_taken_max": 600,
            "max_current_holding": 1,
            "limit_order": false,
            "limit_order_expiration": 5
        },
        "EURUSD": {
            "point": 100000,
            "max_spread": 50,
            "transaction_fee": -10,
            "over_night_penalty": -50,
            "stop_loss_max": -200,
            "profit_taken_max": 500,
            "max_current_holding": 1,
            "limit_order": false,
            "limit_order_expiration": 5
        },
        "AUDUSD": {
            "point": 100000,
            "max_spread": 50,
            "transaction_fee": -5,
            "over_night_penalty": -50,
            "stop_loss_max": -400,
            "profit_taken_max": 800,
            "max_current_holding": 1,
            "limit_order": false,
            "limit_order_expiration": 5
        }
    },
    "trading_hour": {
        "Sydney": {"from": 0, "to": 0},
        "Tokyo": {"from": 0, "to": 0},
        "London": {"from": 0, "to": 0},
        "New York": {"from": 0, "to": 0}
    }
}
